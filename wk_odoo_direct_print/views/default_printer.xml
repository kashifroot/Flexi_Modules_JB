<odoo>
    <data>

        <record id="default_printer_tree" model="ir.ui.view">
            <field name="name">default_printer_tree</field>
            <field name="model">default.printer</field>
            <field name="arch" type="xml">
                <tree string="">
                    <field name="file_type"/>
                    <field name="printer_ids"/>
                </tree>
            </field>
        </record>

        <record id="default_printer_from" model="ir.ui.view">
            <field name="name">default_printer_form</field>
            <field name="model">default.printer</field>
            <field name="arch" type="xml">
                <form string="">
                    <header>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="file_type"/>
                                <field name="printer_ids" options="{'no_create': True}" widget="many2many_tags" domain="[('state', '=', 'Active')]"/>
                            </group>
                            <group>

                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="default_printer_view" model="ir.actions.act_window">
            <field name="name">Default Printer For Attachments</field>
            <field name="res_model">default.printer</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem name="Default Printer for Attachment" sequence="5" id="default_printer_menu" parent="direct_printer_configuration" action="default_printer_view" />
    </data>
</odoo>
