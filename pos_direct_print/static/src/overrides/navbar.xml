<templates id="template" xml:space="preserve">
    <t t-name="DirectPrintPrinterstatus">
    <div class="oe_status btn btn-light rounded-0 d-flex js_direct_print_status">
        <span class="js_msg oe_hidden"></span>

        <div class="js_connected oe_icon oe_green oe_hidden">
            <i class="fa fa-fw fa-print" role="img" title="Printer Connected"></i>
        </div>
        <div class="js_connecting oe_icon oe_orange oe_hidden">
            <i class="fa fa-fw fa-print" role="img" title="Printer waiting for Queue"></i>
        </div>
        <div class="js_disconnected oe_icon oe_red">
            <i class="fa fa-fw fa-print" role="img" title="Printer Disconnected"></i>
        </div>
    </div>
</t>
</templates>
