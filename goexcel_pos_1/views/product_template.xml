<?xml version="1.0" ?>
<odoo>
    <record id="product_template_form_inherit_list_price" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="attrs">{'required': [('product_variant_count', '=', 1)]}</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
<!--                Yulia 21012025 only additional field by kenny, jb no need-->
<!--                <field name="item_code"/>-->
                <field name="second_name"/>
                <field name="third_name"/>
                <field name="order_number"/>
            </xpath>
        </field>
    </record>
</odoo>