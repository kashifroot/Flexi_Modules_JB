<?xml version="1.0" ?>
<odoo>
    <record id="pos_order_form_inherit_scale_barcode" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.scale_barcode</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']/tree/field[@name='product_id']" position="after">
                <field name="scale_barcode"/>
            </xpath>
            <xpath expr="//field[@name='lines']/form/group/field[@name='product_id']" position="after">
                <field name="scale_barcode"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="cancel_pos_order" type="object" string="Cancel Order"/>
            </xpath>
        </field>
    </record>
</odoo>